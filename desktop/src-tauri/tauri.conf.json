{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vardr",
  "version": "0.3.0",
  "identifier": "dev.vardr.desktop",
  "build": {
    "beforeBuildCommand": "python3 ../scripts/prepare-desktop.py",
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vardr",
        "width": 1180,
        "height": 850,
        "minWidth": 640,
        "minHeight": 500,
        "theme": "Dark",
        "backgroundColor": "#101517",
        "create": false
      }
    ],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/vardr"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5ODI2NDgxRUVCRDhGMTcKUldRWGo3M3VnV1NDcWV4MnNTTDBqM2kra1IvcUFqVFlib1pJSmk5bXlENUZrZ21EMUdTMWNxb0MK",
      "endpoints": [
        "https://github.com/oana-ffg/vardr/releases/latest/download/desktop-latest.json"
      ]
    }
  }
}
